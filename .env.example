# Username and password for the website and for the bot.
# The LinkedIn client secret stays here and is never sent to the bot.
AUTH_USERNAME=poster
AUTH_PASSWORD=change-me-at-least-8-chars

# From https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret

# Production origin, no trailing slash. Example: https://your-app.vercel.app
# When set, the OAuth callback is always ${APP_URL}/api/auth/callback
APP_URL=http://localhost:3000

# Optional exact override. Must match the redirect URL registered on the LinkedIn app.
# LINKEDIN_REDIRECT_URI=

# Active LinkedIn API version, YYYYMM. September 2026 docs use 202609.
LINKEDIN_VERSION=202609

# Created automatically when a private Vercel Blob store is connected to this project.
# Local dev works without it: tokens and post history are saved in .data/
# BLOB_READ_WRITE_TOKEN=

# Optional fallback when Blob is not attached. Refresh cannot be saved in this mode.
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_REFRESH_TOKEN=
# LINKEDIN_PERSON_URN=urn:li:person:...
# LINKEDIN_TOKEN_EXPIRES_AT=
# LINKEDIN_MEMBER_NAME=
